[Unit]
Description=RFID Station Swipe Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=siil
WorkingDirectory=/home/siil/station-server
EnvironmentFile=/etc/station-server.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/siil/station-server/venv/bin/gunicorn --workers 1 --threads 4 --bind 0.0.0.0:5000 --timeout 30 app:app
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
